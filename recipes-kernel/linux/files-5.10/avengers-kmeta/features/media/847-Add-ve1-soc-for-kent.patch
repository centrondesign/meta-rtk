From c4a5ae463ceeb6ee025bbab0927f46346856a2f4 Mon Sep 17 00:00:00 2001
From: "joshua.yang" <joshua.yang@realtek.com>
Date: Fri, 10 Apr 2026 17:14:32 +0800
Subject: [PATCH 1/3] Add ve1 soc for kent

---
 drivers/soc/realtek/Kconfig                   |   30 +-
 drivers/soc/realtek/Makefile                  |    1 +

diff --git a/drivers/soc/realtek/Kconfig b/drivers/soc/realtek/Kconfig
index 275d207bbfec..fd55bb47cba6 100644
--- a/drivers/soc/realtek/Kconfig
+++ b/drivers/soc/realtek/Kconfig
@@ -6,16 +6,13 @@ config RTK_RESERVE_MEMORY
 
 config RTK_PUWRAP
 	tristate
-	select RTK_RESERVE_MEMORY
 
 config RTK_IMAGE_CODEC
 	tristate "RTK Image Codec"
-	select RTK_PUWRAP
 	default y
 
 menuconfig RTD13XX_RTK_CODEC
 	tristate "Realtek RTD13XX Codec"
-	select RTK_RESERVE_MEMORY
 	default n
 	help
 	  Realtek RTD13XX codec support.
@@ -25,12 +22,10 @@ menuconfig RTD13XX_RTK_CODEC
 config RTD13XX_VE1_CODEC
 	tristate "RTK Video Engine 1 Codec"
 	depends on RTD13XX_RTK_CODEC
-	select RTK_PUWRAP
 	default n
 
 menuconfig RTD13XXD_RTK_CODEC
 	tristate "Realtek RTD13XXD Codec"
-	select RTK_RESERVE_MEMORY
 	default n
 	help
 	  Realtek RTD13XXD codec support.
@@ -40,12 +35,10 @@ menuconfig RTD13XXD_RTK_CODEC
 config RTD13XXD_VE1_CODEC
 	tristate "RTK Video Engine 1 Codec"
 	depends on RTD13XXD_RTK_CODEC
-	select RTK_PUWRAP
 	default n
 
 menuconfig RTD13XXE_RTK_CODEC
         tristate "Realtek RTD13XXE Codec"
-        select RTK_RESERVE_MEMORY
         default n
         help
           Realtek RTD13XXE codec support.
@@ -55,12 +48,10 @@ menuconfig RTD13XXE_RTK_CODEC
 config RTD13XXE_VE1_CODEC
         tristate "RTK Video Engine 1 Codec"
         depends on RTD13XXE_RTK_CODEC
-        select RTK_PUWRAP
         default n
 
 menuconfig RTD16XXB_RTK_CODEC
 	tristate "Realtek RTD16XXB Codec"
-	select RTK_RESERVE_MEMORY
 	default n
 	help
 	  Realtek RTD16XXB codec support.
@@ -70,7 +61,6 @@ menuconfig RTD16XXB_RTK_CODEC
 config RTD16XXB_VE1_CODEC
 	tristate "RTK Video Engine 1 Codec"
 	depends on RTD16XXB_RTK_CODEC
-	select RTK_PUWRAP
 	default n
 
 config REALTEK_SOC
@@ -91,6 +81,26 @@ config SENDFILE_PATCH
 
 	  If unsure, say N.
 
+menuconfig RTK_KENT_CODEC
+	tristate "Realtek KENT Codec"
+	default n
+	help
+	  Realtek KENT codec support.
+
+	  If unsure, say N.
+
+config RTK_KENT_VE1
+	tristate "RTK Video Engine 1 Codec"
+	depends on RTK_KENT_CODEC
+	default n
+
+config RTK_KENT_VE4
+	tristate "RTK Video Engine 4 Codec"
+	depends on RTK_KENT_CODEC
+	default n
+	help
+	  The encoder driver for Realtek Kent SoCs. If unsure, say N.
+
 source "drivers/soc/realtek/common/Kconfig"
 source "drivers/soc/realtek/cpudvfs/Kconfig"
 source "drivers/soc/realtek/cpuhp/Kconfig"
diff --git a/drivers/soc/realtek/Makefile b/drivers/soc/realtek/Makefile
index c444e8920af9..0a1a3e0cd5bd 100644
--- a/drivers/soc/realtek/Makefile
+++ b/drivers/soc/realtek/Makefile
@@ -3,6 +3,7 @@ obj-y += rtd13xx/
 obj-y += rtd13xxd/
 obj-y += rtd16xxb/
 obj-y += rtd13xxe/
+obj-y += kent/
 obj-y += cpudvfs/
 obj-y += cpuhp/
 obj-y += gpu/
-- 
2.34.1

