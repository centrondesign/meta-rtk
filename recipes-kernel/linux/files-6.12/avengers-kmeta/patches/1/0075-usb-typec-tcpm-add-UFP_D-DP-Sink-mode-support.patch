+/*
+ * tcpm_register_partner_altmode_for_ufpd - Register partner altmode for UFP_D mode
+ *
+ * In UFP_D mode, the DFP partner initiates VDM discovery. When we receive
+ * Enter Mode request, we need to register a partner altmode so that the
+ * typec_bus can pair it with our port_altmode and probe the altmode driver.
+ *
+ * @port: TCPM port
+ * @svid: SVID from the Enter Mode request
+ * @mode: Mode index from the Enter Mode request
+ *
+ * Returns: pointer to the registered altmode, or NULL on failure
+ */
+static struct typec_altmode *
+tcpm_register_partner_altmode_for_ufpd(struct tcpm_port *port, u16 svid, u8 mode)
+{
+	struct typec_altmode_desc desc;
+	struct typec_altmode *altmode;
+	struct typec_altmode *port_alt;
+	int i;
+
+	if (!port->partner) {
+		tcpm_log(port, "UFP_D: Cannot register partner altmode - no partner");
+		return NULL;
+	}
+
+	/* Check if already registered */
+	for (i = 0; i < ALTMODE_DISCOVERY_MAX && port->partner_altmode[i]; i++) {
+		if (port->partner_altmode[i]->svid == svid &&
+		    port->partner_altmode[i]->mode == mode) {
+			tcpm_log(port, "UFP_D: Partner altmode SVID 0x%04x mode %d already registered",
+				 svid, mode);
+			return port->partner_altmode[i];
+		}
+	}
+
+	/* Find a free slot */
+	for (i = 0; i < ALTMODE_DISCOVERY_MAX; i++) {
+		if (!port->partner_altmode[i])
+			break;
+	}
+
+	if (i >= ALTMODE_DISCOVERY_MAX) {
+		tcpm_log(port, "UFP_D: No free slot for partner altmode");
+		return NULL;
+	}
+
+	/*
+	 * For UFP_D mode, the partner is DFP_D (DisplayPort Source).
+	 * We construct a VDO that indicates DFP_D capability.
+	 * This allows displayport_rx.c probe to succeed.
+	 *
+	 * Find our port altmode to get compatible pin assignments.
+	 */
+	port_alt = typec_match_altmode(port->port_altmode, ALTMODE_DISCOVERY_MAX,
+				       svid, mode);
+
+	memset(&desc, 0, sizeof(desc));
+	desc.svid = svid;
+	desc.mode = mode;
+
+	if (port_alt && svid == USB_TYPEC_DP_SID) {
+		/*
+		 * Construct partner VDO for DisplayPort:
+		 * - Partner is DFP_D (Source) since we are UFP_D (Sink)
+		 * - Set as Receptacle so DFP_D pins are in bits 15-8
+		 *   (matches DP_CAP_PIN_ASSIGN_DFP_D macro behavior)
+		 * - Use complementary pin assignments from our port VDO
+		 */
+		u8 our_ufp_pins = DP_CAP_PIN_ASSIGN_UFP_D(port_alt->vdo);
+		desc.vdo = DP_CAP_DFP_D |  /* Partner is DFP_D */
+			   DP_CAP_RECEPTACLE |  /* Partner is Receptacle (DFP_D pins in bits 15-8) */
+			   (our_ufp_pins << 8) |  /* Partner DFP_D pins = our UFP_D pins */
+			   DP_CAP_USB;  /* Assume USB concurrent */
+		tcpm_log(port, "UFP_D: Constructed partner VDO 0x%08x (DFP_D Receptacle, pins=0x%02x)",
+			 desc.vdo, our_ufp_pins);
+	} else {
+		/* Default: just mark as having the capability */
+		desc.vdo = 0x00000001;
+	}
+
+	altmode = typec_partner_register_altmode(port->partner, &desc);
+	if (IS_ERR(altmode)) {
+		tcpm_log(port, "UFP_D: Failed to register partner altmode SVID 0x%04x",
+			 svid);
+		return NULL;
+	}
+
+	port->partner_altmode[i] = altmode;
+	tcpm_log(port, "UFP_D: Registered partner altmode[%d] SVID 0x%04x mode %d VDO 0x%08x",
+		 i, svid, mode, desc.vdo);
+
+	return altmode;
+}
