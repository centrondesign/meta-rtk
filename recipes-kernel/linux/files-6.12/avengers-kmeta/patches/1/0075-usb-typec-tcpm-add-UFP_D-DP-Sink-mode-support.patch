 #define supports_modal(port)	PD_IDH_MODAL_SUPP((port)->partner_ident.id_header)
 #define supports_modal_cable(port)     PD_IDH_MODAL_SUPP((port)->cable_ident.id_header)
 #define supports_host(port)    PD_IDH_HOST_SUPP((port->partner_ident.id_header))
@@ -2037,21 +2183,161 @@ static int tcpm_pd_svdm(struct tcpm_port *port, struct typec_altmode *adev,
 			break;
 		case CMD_DISCOVER_SVID:
 			port->ams = DISCOVER_SVIDS;
+			/*
+			 * UFP_D Support: Build Discover SVIDs response
+			 * Collect SVIDs from registered port altmodes
+			 */
+			if (port->data_role == TYPEC_DEVICE || svdm_version >= SVDM_VER_2_0) {
+				u32 svid_vdo = 0;
+				int svid_idx = 0;
+
+				/* Iterate through port_altmode to collect SVIDs */
+				for (i = 0; i < ALTMODE_DISCOVERY_MAX && port->port_altmode[i]; i++) {
+					u16 svid = port->port_altmode[i]->svid;
+
+					if (svid_idx & 1)
+						svid_vdo |= svid;  /* Lower 16 bits */
+					else
+						svid_vdo = (u32)svid << 16;  /* Upper 16 bits */
+
+					svid_idx++;
+
+					/* Each VDO contains 2 SVIDs */
+					if ((svid_idx & 1) == 0) {
+						response[rlen + 1] = svid_vdo;
+						rlen++;
+						svid_vdo = 0;
+					}
+				}
+
+				/* Add last VDO if odd number of SVIDs (with 0x0000 terminator) */
+				if (svid_idx & 1) {
+					response[rlen + 1] = svid_vdo;  /* Lower 16 bits already 0 */
+					rlen++;
+				}
+
+				/* If we have SVIDs, add header count */
+				if (rlen > 0)
+					rlen++;  /* +1 for VDM header */
+
+				tcpm_log(port, "UFP_D: Discover SVIDs response with %d SVIDs", svid_idx);
+			}
 			break;
 		case CMD_DISCOVER_MODES:
 			port->ams = DISCOVER_MODES;
+			/*
+			 * UFP_D Support: Build Discover Modes response
+			 * Find the altmode matching the requested SVID and return its VDO
+			 */
+			if (port->data_role == TYPEC_DEVICE || svdm_version >= SVDM_VER_2_0) {
+				u16 req_svid = PD_VDO_VID(p[0]);
+				struct typec_altmode *alt;
+
+				/* Find matching port altmode by SVID */
+				for (i = 0; i < ALTMODE_DISCOVERY_MAX && port->port_altmode[i]; i++) {
+					alt = port->port_altmode[i];
+					if (alt->svid == req_svid) {
+						response[1] = alt->vdo;
+						rlen = 2;  /* VDM header + Mode VDO */
+						tcpm_log(port, "UFP_D: Discover Modes for SVID 0x%04x, VDO=0x%08x",
+							 req_svid, alt->vdo);
+						break;
+					}
+				}
+
+				if (rlen == 0)
+					tcpm_log(port, "UFP_D: No mode found for SVID 0x%04x", req_svid);
+			}
 			break;
 		case CMD_ENTER_MODE:
 			port->ams = DFP_TO_UFP_ENTER_MODE;
+			/*
+			 * UFP_D Support: Handle Enter Mode request
+			 * Forward to altmode driver which will send the response
+			 */
+			if (port->data_role == TYPEC_DEVICE || svdm_version >= SVDM_VER_2_0) {
+				u16 req_svid = PD_VDO_VID(p[0]);
+				u8 req_opos = PD_VDO_OPOS(p[0]);
+
+				/* Find matching port altmode */
+				adev = typec_match_altmode(port->port_altmode, ALTMODE_DISCOVERY_MAX,
+							   req_svid, req_opos);
+				if (adev) {
+					/*
+					 * In UFP_D mode, we need to register a partner altmode
+					 * so that typec_bus can pair it with port_altmode and
+					 * probe the altmode driver (displayport_rx.c).
+					 *
+					 * This must be done before ADEV_QUEUE_VDM because
+					 * typec_altmode_vdm() requires altmode->partner to exist.
+					 */
+					if (!tcpm_register_partner_altmode_for_ufpd(port, req_svid, req_opos)) {
+						tcpm_log(port, "UFP_D: Enter Mode NAK - failed to register partner altmode");
+						break;
+					}
+
+					/*
+					 * Forward to altmode driver (displayport_rx.c)
+					 * The driver will handle the response via tcpm_altmode_vdm()
+					 * Return 0 to skip TCPM's own response
+					 */
+					tcpm_log(port, "UFP_D: Enter Mode for SVID 0x%04x OPOS %d -> forward to altmode driver",
+						 req_svid, req_opos);
+					*adev_action = ADEV_QUEUE_VDM;
+					return 0;
+				} else {
+					tcpm_log(port, "UFP_D: Enter Mode NAK - no altmode for SVID 0x%04x OPOS %d",
+						 req_svid, req_opos);
+				}
+			}
 			break;
 		case CMD_EXIT_MODE:
 			port->ams = DFP_TO_UFP_EXIT_MODE;
+			/*
+			 * UFP_D Support: Handle Exit Mode request
+			 * Forward to altmode driver which will send the response
+			 */
+			if (port->data_role == TYPEC_DEVICE || svdm_version >= SVDM_VER_2_0) {
+				u16 req_svid = PD_VDO_VID(p[0]);
+				u8 req_opos = PD_VDO_OPOS(p[0]);
+
+				adev = typec_match_altmode(port->port_altmode, ALTMODE_DISCOVERY_MAX,
+							   req_svid, req_opos);
+				if (adev) {
+					tcpm_log(port, "UFP_D: Exit Mode for SVID 0x%04x OPOS %d -> forward to altmode driver",
+						 req_svid, req_opos);
+					*adev_action = ADEV_QUEUE_VDM;
+					return 0;
+				}
+			}
 			break;
 		case CMD_ATTENTION:
 			/* Attention command does not have response */
 			*adev_action = ADEV_ATTENTION;
 			return 0;
 		default:
+			/*
+			 * UFP_D Support: Handle SVID-specific vendor commands
+			 * (e.g., DP Status Update = 0x10, DP Configure = 0x11)
+			 * Forward to altmode driver which will send the response
+			 */
+			if ((port->data_role == TYPEC_DEVICE || svdm_version >= SVDM_VER_2_0) &&
+			    cmd >= CMD_ATTENTION) {
+				u16 req_svid = PD_VDO_VID(p[0]);
+				u8 req_opos = PD_VDO_OPOS(p[0]);
+
+				/* Find matching port altmode for this SVID */
+				adev = typec_match_altmode(port->port_altmode, ALTMODE_DISCOVERY_MAX,
+							   req_svid, req_opos);
+				if (adev) {
+					tcpm_log(port, "UFP_D: Vendor cmd 0x%02x for SVID 0x%04x -> forward to altmode driver",
+						 cmd, req_svid);
+					*adev_action = ADEV_QUEUE_VDM;
+					return 0;
+				}
+				tcpm_log(port, "UFP_D: Vendor cmd 0x%02x NAK - no altmode for SVID 0x%04x",
+					 cmd, req_svid);
+			}
 			break;
 		}
 		if (rlen >= 1) {
@@ -2065,6 +2351,8 @@ static int tcpm_pd_svdm(struct tcpm_port *port, struct typec_altmode *adev,
 		}
 		response[0] = (response[0] & ~VDO_SVDM_VERS_MASK) |
