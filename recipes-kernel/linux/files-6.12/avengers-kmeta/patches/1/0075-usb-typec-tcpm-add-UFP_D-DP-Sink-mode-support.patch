+/*
+ * Hybrid DR_Swap work function
+ * Called when timeout expires waiting for partner to initiate DR_Swap
+ * This supports passive Type-C to DP cables that cannot initiate PD messages
+ */
+static void dr_swap_wait_work(struct kthread_work *work)
+{
+	struct tcpm_port *port = container_of(work, struct tcpm_port, dr_swap_wait_work);
+	int i;
+
+	mutex_lock(&port->lock);
+
+	/* Check if we're still waiting and conditions are still valid */
+	if (!port->waiting_for_partner_dr_swap) {
+		tcpm_log(port, "DR_Swap wait cancelled, no action needed");
+		mutex_unlock(&port->lock);
+		return;
+	}
+
+	port->waiting_for_partner_dr_swap = false;
+
+	/* Check if we're SOURCE/DFP and need to become UFP for UFP_D */
+	if (port->pwr_role == TYPEC_SOURCE && port->data_role == TYPEC_HOST && port->explicit_contract) {
+		/* Check if we have UFP_D port */
+		for (i = 0; i < ALTMODE_DISCOVERY_MAX && port->port_altmode[i]; i++) {
+			if (port->port_altmode[i]->svid == USB_TYPEC_DP_SID &&
+			    DP_CAP_CAPABILITY(port->port_altmode[i]->vdo) == DP_CAP_UFP_D) {
+				tcpm_log(port, "[Hybrid DR_Swap] Partner did not initiate DR_Swap, "
+					 "initiating ourselves for UFP_D support");
+				port->upcoming_state = DR_SWAP_SEND;
+				if (tcpm_ams_start(port, DATA_ROLE_SWAP) == -EAGAIN) {
+					tcpm_log(port, "[Hybrid DR_Swap] Failed to start DR_Swap AMS, will retry");
+					port->upcoming_state = INVALID_STATE;
+				}
+				break;
+			}
+		}
+	} else {
+		tcpm_log(port, "[Hybrid DR_Swap] Conditions changed, DR_Swap not needed "
+			 "(pwr_role=%d, data_role=%d, explicit_contract=%d)",
+			 port->pwr_role, port->data_role, port->explicit_contract);
+	}
+
+	mutex_unlock(&port->lock);
+}
