/dts-v1/;

#include <dt-bindings/regulator/anpec,apw888x.h>
#include "rtd16xxb-rescue.dtsi"

&pinctrl {
	apw7899_int_pins: apw7899-int-pins {
		pins = "gpio_40";
		function = "gpio";
		bias-pull-up;
	};

	apw7899_led_pins: apw7899-led-pins {
		pins = "gpio_27";
		function = "gpio";
	};
};

/ {
	model = "Centron Design CT1833 Rescue";

	memory@40000 {
		device_type = "memory";
		reg = <0x00040000 0x3ffc0000>; /* 1 GiB */
	};

	aliases {
		ethernet = &nic;
	};

	vcc_ddr: vcc1v2-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v2-ddr";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};
};

&i2c_0 {
	clock-frequency = <3400000>;
	pinctrl-0 = <&i2c_pins_0_HS>;
	status = "okay";

	apw7899: apw7899@12 {
		compatible = "anpec,apw7899";
		reg = <0x12>;

		pinctrl-names = "default";
		pinctrl-0 = <&apw7899_int_pins &apw7899_led_pins>;
		interrupt-parent = <&gpio>;

		/*
		 * gpio_40 is on the PMIC /INT pin: open-drain, active-low,
		 * latched. It drops when the PMIC latches a pwrkey event
		 * and returns high (pull-up above) only after the handler
		 * writes REG00.INT = 0. Falling edge only - one IRQ per
		 * PMIC event (IT, then LP).
		 */
		interrupts = <40 IRQ_TYPE_EDGE_FALLING>;

		/* gpio_27: LED output */
		led-gpios = <&gpio 27 GPIO_ACTIVE_HIGH>;

		regulators {
			compatible = "anpec,apw8886-regulator";

			vd33_supp: dc1 {
				regulator-name = "vd33";
				regulator-min-microvolt = <2200000>;
				regulator-max-microvolt = <3777500>;

				regulator-boot-on;
				regulator-always-on;
				regulator-initial-mode = <APW888X_DC_MODE_AUTO>;
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			core_supp: dc2 {
				regulator-name = "core";
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <1337500>;

				regulator-boot-on;
				regulator-always-on;
				regulator-initial-mode = <APW888X_DC_MODE_AUTO>;
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <800000>;
				};
			};

			cpu_supp: dc3 {
				regulator-name = "cpudvs";
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <1337500>;

				regulator-boot-on;
				regulator-always-on;
				regulator-initial-mode = <APW888X_DC_MODE_AUTO>;
				regulator-ramp-delay = <625>;
				apw888x-disabled-in-shutdown;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-changeable-in-suspend;
				};
			};

			vd18_supp: dc4 {
				regulator-name = "vd18";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2060000>;

				regulator-boot-on;
				regulator-always-on;
				regulator-initial-mode = <APW888X_DC_MODE_AUTO>;
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			ddr_supp: dc5 {
				regulator-name = "ddr";
				regulator-boot-on;
				regulator-always-on;
				regulator-initial-mode = <APW888X_DC_MODE_AUTO>;
				vin-supply = <&vcc_ddr>;
				apw888x-disabled-in-shutdown;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vd25_supp: ldo1 {
				regulator-name = "vd25";
				regulator-min-microvolt = <1780000>;
				regulator-max-microvolt = <3020000>;

				regulator-boot-on;
				regulator-always-on;
				regulator-initial-mode = <APW888X_LDO_MODE_NORMAL>;
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vfb5 {
				regulator-name = "vfb5";
				regulator-min-microvolt = <512500>;
				regulator-max-microvolt = <700000>;

				regulator-boot-on;
				regulator-always-on;
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
		};
	};
};

&sd {
	status = "okay";
};

&pcie1 {
	status = "okay";
	perst-gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
};

&pcie1_phy {
	status = "okay";
};

&pcie2 {
	status = "okay";
	perst-gpios = <&gpio 45 GPIO_ACTIVE_HIGH>;
};

&pcie2_phy {
	status = "okay";
};

&sata_phy {
	status = "disabled";
};

&sata_phy0 {
	status = "disabled";
};

&sata_phy1 {
	status = "disabled";
};

&ahci_sata {
	hostinit-mode = <0>;
	status = "disabled";
};

&sata_port0 {
	status = "disabled";
};

&sata_port1 {
	status = "disabled";
};

&usb_port0 {
	realtek,power-gpio = <&gpio 44 GPIO_ACTIVE_HIGH>;
};

&usb_port1 {
	/delete-property/realtek,power-gpio;
};

&usb_port2 {
	/delete-property/realtek,power-gpio;
};

&i2c_5 {
	status = "okay";

	rx8010: rtc@32 {
		compatible = "epson,rx8010";
		reg = <0x32>;
	};
};

&avcert_rproc {
	status = "okay";
};

&acpu_rproc {
	firmware-name = "bluecore.audio.enc.A00-stark-noaudio-nonsecure-0112";
	status = "okay";
};

&display_subsystem {
	ports = <&vo_out>;
	status = "okay";
};

&vowb {
        status = "disabled";
};

&vo {
	status = "okay";
	compatible = "realtek,rtd-crtc-main-all";
};

&voext {
	status = "disabled";
};

&hdmi {
	ext-flags = <0x1>;
};

&sb2 {
	acpu-rpmsg {
		rproc = <&acpu_rproc>;
		status = "okay";
	};

	vcpu-rpmsg {
		status = "disabled";
	};

	hifi-rpmsg {
		status = "disabled";
	};

	ve3-rpmsg {
		status = "disabled";
	};

};

&reserved_memory {
	protected-mem@50000 {
		status = "okay";
	};

	metadata@c40000 {
		status = "disabled";
	};

	tee@10000000 {
		status = "disabled";
	};

	buffer@2F700000 {
		status = "disabled";
	};

	cma_reserved_0:linux,default_cma {
		compatible = "shared-dma-pool";
		size = <0x10000000>;            /* 256M */
		alignment = <0x00400000>;
		alloc-ranges=<0x30000000 0x10000000>;
		linux,cma-default;
		reusable;
	};

	/delete-node/tp_ssc2;
	/delete-node/audio_ssc1;
	/delete-node/video_dsc5;
	/delete-node/ao_ssc6;
	/delete-node/ota_dsc8;
	/delete-node/fwstack_ssc4;
	/delete-node/hifi_b1p5;
	/delete-node/vo_s_dsc3;
	/delete-node/npp;
	/delete-node/npu-inference;
	/delete-node/npu-model;
	/delete-node/vo_dsc3;

	cma_reserved_2:vo_dsc3 {
		compatible = "shared-dma-pool";
		size = <0x8000000>;            /* 128M */
		alignment = <0x00400000>;
		/* Avoid crossing A/VCPU PA2VA per 512M boundary */
		/* Avoid allocating 0x1fc00000 ~ 0x1fc00fff to LX CPU (A/VCPU/VE3) */
		alloc-ranges=<0x28000000 0x8000000>;
		reusable;
	};

	cma_reserved_3:vo5 {
		compatible = "shared-dma-pool";
		size = <0x20000000>;            /* 512M */
		alignment = <0x00400000>;
		/* Avoid crossing A/VCPU PA2VA per 512M boundary */
		/* Avoid allocating 0x1fc00000 ~ 0x1fc00fff to LX CPU (A/VCPU/VE3) */
		alloc-ranges=<0x40000000 0x20000000>;
		reusable;
	};
};
