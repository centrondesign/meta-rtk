#include "rtd1619b-bleedingedge-2gb.dts"

/ {
	model = "Centron Design CT1833";
};

&vo {
	compatible = "realtek,rtd-crtc-main";
};

&audio_out {
	/delete-property/audio-gpios;
};

&hdmi {
	hdmi5v-gpios = <&gpio 5 GPIO_ACTIVE_HIGH>;
};

&i2c_5 {
	rx8010: rtc@32 {
		compatible = "epson,rx8010";
		reg = <0x32>;
	};
};

&pcie1 {
	perst-gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
};

&pcie2 {
	perst-gpios = <&gpio 45 GPIO_ACTIVE_HIGH>;
};

&sdio {
	/delete-property/wifi-rst-gpios;
	status = "disabled";
};

&rtk_asoc_machine {
	/delete-property/pinctrl-0;
	realtek,dai-link = "RDAI_DL1_FE", "RDAI_UL1_FE", "RDAI_SOC_AO0", "RDAI_SOC_I2S";
};

&usb_port0 {
	realtek,power-gpio = <&gpio 44 GPIO_ACTIVE_HIGH>;
};

&usb_port1 {
	/delete-property/realtek,power-gpio;
};

&usb_port2 {
	/delete-property/realtek,power-gpio;
	dwc3@50000 {
		dr_mode = "host"; /* otg, host, peripheral*/
		/delete-property/usb-role-switch;
		/delete-property/role-switch-default-mode;
	};
};

/delete-node/ &type_c;

&apw7899 {
	/* Trigger PMIC SOFTOFF (true power-off, power-key wakeable) on shutdown */
	anpec,softoff-on-shutdown;
};
